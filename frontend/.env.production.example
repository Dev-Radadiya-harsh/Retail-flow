# Local development uses frontend/.env.development (local API via Vite proxy). Do not copy this file for dev.
#
# Copy to .env.production (same folder as this file):
#   cp .env.production.example .env.production
# Or: cp env.production.template .env.production
#
# Replace with your Render URL — must end with /api
# Example: https://retailflow-abc.onrender.com/api

VITE_API_BASE_URL=https://retail-flow-essq.onrender.com/api