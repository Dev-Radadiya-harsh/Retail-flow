# Local dev uses frontend/.env.development (Vite proxy). This file is for: npm run build + Firebase deploy only.
#
# Easiest (tunnel + auto-write): from repo root, with backend running on 3001:
#   npm run tunnel:write
# That writes this file for you. Then: npm run deploy:hosting
#
# Or copy manually:
#   cp .env.production.example .env.production
#
# Pick ONE base URL — must end with /api
#
# --- No Render: localtunnel / ngrok / Cloudflare Tunnel ---
# VITE_API_BASE_URL=https://YOUR-SUBDOMAIN.loca.lt/api
#
# --- Optional: always-on API on Render ---
# VITE_API_BASE_URL=https://your-service.onrender.com/api

VITE_API_BASE_URL=https://YOUR-TUNNEL-OR-HOST.example.com/api
