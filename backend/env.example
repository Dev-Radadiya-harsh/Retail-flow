# Copy to backend/.env for local overrides (see DEPLOYMENT.md for Render).

# Optional: full path to SQLite file. Default is backend/db/retailflow.db
# DATABASE_PATH=/var/data/retailflow.db

# JWT_SECRET=your-secret-here
# Required for Firebase-hosted frontend (comma-separated, no spaces):
# FRONTEND_ORIGIN=https://your-project.web.app,https://your-project.firebaseapp.com
